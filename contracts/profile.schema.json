{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quest:compositor:profile:v1",
  "title": "Quest compositor source profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "backend", "passes", "compatibility_id"],
  "properties": {
    "schema": {"const": "quest.compositor.profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "backend": {"const": "gles-body-es310"},
    "compatibility_id": {"const": "experimental-gles-body-es310"},
    "passes": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"$ref": "#/$defs/shaderPass"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-](?:[A-Za-z0-9_.-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_-](?:[A-Za-z0-9_.-]*[A-Za-z0-9_-])?$",
      "description": "Portable root-relative path; loader additionally rejects reserved Windows names, missing sources, symlinks, junctions and escapes."
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimension": {"type": ["integer", "null"], "minimum": 1, "maximum": 2147483647},
    "shaderPass": {
      "type": "object", "additionalProperties": false,
      "required": ["vertex_path", "fragment_path", "vertex_sha256", "fragment_sha256", "filter", "width", "height"],
      "properties": {
        "vertex_path": {"$ref": "#/$defs/path"},
        "fragment_path": {"$ref": "#/$defs/path"},
        "vertex_sha256": {"$ref": "#/$defs/sha256"},
        "fragment_sha256": {"$ref": "#/$defs/sha256"},
        "filter": {"enum": ["linear", "nearest"]},
        "width": {"$ref": "#/$defs/dimension"},
        "height": {"$ref": "#/$defs/dimension"}
      },
      "oneOf": [
        {"properties": {"width": {"type": "null"}, "height": {"type": "null"}}},
        {"properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}}
      ]
    }
  }
}
